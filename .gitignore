# Python bytecode
__pycache__/
*.pyc

# Large, regenerable pipeline outputs (rebuild with pipeline/run_all.py)
outputs/*/county_daily_heat.csv
outputs/*/nws_proxy_daily.csv
outputs/*/def_p*/tables/thresholds_w15.csv
outputs/*/def_p*/tables/daily_heatwave_days_*.csv

# Definition grid (pipeline/run_grid.py). Tracked: the per-run event tables
# (gzipped), county-year and county-month summaries, every figure, and the whole
# _comparison layer. NOT tracked -- both are large and fully regenerable by re-running
# the grid (~7.5 min):
#   _thresholds/           ~1M rows per centered window x metric x percentile
#   daily_heatwave_days_*  one row per heatwave county-day, per run
outputs/*/grid/_thresholds/
outputs/*/grid/*/tables/daily_heatwave_days_*.csv.gz

# Definition-comparison package (outputs/definition_comparison/scripts/run_package.py).
# TRACKED: every script, the 8 required tables, the support tables the figures read,
# all core/supplement figures, the whole qa/ record, the data dictionary, the written
# deliverables (figure_captions.md, methods_notes.md, DECISION_TABLE.md, README.md,
# run_manifest.csv) and county_profiles/INDEX.csv -- about 10 MB in total.
# NOT TRACKED (~540 MB, all regenerable; run_manifest.csv still records every one of
# them with its size, timestamp and producing script):
#   tables/canonical_long/      one row per candidate county-day x definition x window
#   the three master tables     county-year / county-month / event, all 64 runs
#   county_profiles/*/          254 report cards + their per-county CSVs (s06, ~10 min)
#   event_audits/*.png          the event timelines and long-event audit figures (s07)
outputs/definition_comparison/tables/canonical_long/
outputs/definition_comparison/tables/master_county_month_summary.csv
outputs/definition_comparison/tables/master_county_year_summary.csv
outputs/definition_comparison/tables/master_event_table.csv.gz
outputs/definition_comparison/tables/eligibility_county_month.csv
outputs/definition_comparison/county_profiles/*/
outputs/definition_comparison/event_audits/*.png

# Extreme-temperature tests (outputs/extreme_temp_tests/scripts/e01..e04).
# TRACKED: all scripts, all figures, the e01/e02/e03 summary tables, the whole qa/
# record and the written deliverables (~10 MB). NOT TRACKED (~116 MB, regenerable
# by re-running e02, ~5 min): the per-run event / county-year / county-month /
# daily tables for the 60 runs, and the 5.5 MB county-year temperature layer.
outputs/extreme_temp_tests/runs/
outputs/extreme_temp_tests/tables/e01_county_year_temperature.csv

# Extreme-temperature REVISION v2 (outputs/extreme_temperature_revision_v2/scripts/
# run_revision.py, ~9 min). TRACKED: all scripts, all 21 figures, the data
# dictionary, the definition registry, the whole qa/ record, the county profiles,
# the event audits and the written deliverables (~55 MB). NOT TRACKED (~470 MB,
# fully regenerable): the individual event catalogues and the monthly county-level
# layers, which are row-per-event and row-per-county-month tables.
outputs/extreme_temperature_revision_v2/tables/individual_*.csv
outputs/extreme_temperature_revision_v2/tables/county_monthly_*.csv
outputs/extreme_temperature_revision_v2/tables/county_annual_all_constructs.csv
outputs/extreme_temperature_revision_v2/tables/long_event_audit.csv
outputs/extreme_temperature_revision_v2/current_vs_revised/reproduction/
outputs/extreme_temperature_revision_v2/qa/_classified_day_sets.npz

# OS / editor cruft
.DS_Store
Thumbs.db

# reference: keep QA renders / comparison scratch out of git (regenerate from the .pptx)
reference/Heatwave_Reference_Appendix.pdf
reference/Heatwave_Results_Deck.pdf
reference/comparison_figures/

# Heatwave-definition scenario package (outputs/heatwave_scenarios/).
# Tracked: all scripts, tests, per-construct summary tables, figures, QA, reports.
# NOT tracked (large, fully regenerable by rerunning hs01->hs02, ~11 min):
#   _derived_variables_*  the full county-day panel with EHF components (~4.4M rows)
#   per-construct daily classification / event detail files
outputs/heatwave_scenarios/tables/_derived_variables_*.csv.gz
outputs/heatwave_scenarios/tables/*/tables/daily_classified.csv.gz
outputs/heatwave_scenarios/tables/*/tables/events.csv.gz
outputs/heatwave_scenarios/tables/*/tables/heatwave_events.csv.gz
outputs/heatwave_scenarios/tables/*/tables/ehf_positive_assessment_dates.csv.gz
